# ── LLM Configuration ────────────────────────────────────────────────────────
# Cerebras API key — required for CrewAI agent reasoning.
# Get one at https://cloud.cerebras.ai/ and paste it here. NEVER commit a real key.
CEREBRAS_API_KEY=your-cerebras-api-key-here

# LLM model identifier (LiteLLM format)
LLM_MODEL=cerebras/llama3.1-8b

# LLM parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── Pipeline Configuration ───────────────────────────────────────────────────
# Override config file path (default: configs/default.yaml)
# CONFIG_PATH=configs/default.yaml

# Pipeline random seed for reproducibility
# RANDOM_SEED=42

# Maximum retry attempts for improvement loop
# MAX_RETRIES=3

# ── API / CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# Defaults to the local Next.js dev server if unset. Set this to your real
# frontend origin(s) in production — never use "*".
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session token lifetime in days (how long a login stays valid).
SESSION_TTL_DAYS=7

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Paths ────────────────────────────────────────────────────────────────────
# ARTIFACT_DIR=artifacts
# REPORT_DIR=reports
# LOG_DIR=logs

# ── Database (optional — for SQL data ingestion) ─────────────────────────────
# DATABASE_URL=sqlite:///data/source.db

# ── MLflow (optional) ────────────────────────────────────────────────────────
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=auto-ds-pipeline
