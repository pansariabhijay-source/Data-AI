# Keep the build context small and the image clean.
# Python envs & caches
venv/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next (frontend has its own image + .dockerignore)
frontend/node_modules/
frontend/.next/
frontend/.next-devtest.log
node_modules/

# Generated run outputs (mounted as volumes at runtime instead)
artifacts/
reports/
logs/
data/uploads/
data/*.db
data/*.db-*

# Large datasets — never bake data into the image
*.csv
*.ipynb

# Secrets & local config
.env
.claude/
**/.claude/settings.local.json

# VCS & docs noise
.git/
.gitignore
.DS_Store
*.md
!README.md
